# ==========================================
# BASEMOOD ADMIN PANEL SECURITY
# .htaccess защита
# ==========================================

# Отключение списка файлов
Options -Indexes

# Блокировка прямого доступа ко всем PHP файлам ЗА ИСКЛЮЧЕНИЕМ index.php
<Files "*.php">
    Require all denied
</Files>

<Files "index.php">
    Require all granted
</Files>

# Блокировка доступа к конфиг файлам
<FilesMatch "\.(htaccess|env|log|sql)$">
    Require all denied
</FilesMatch>

# Стандартные заголовки безопасности
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

