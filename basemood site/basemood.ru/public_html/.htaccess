<IfModule mod_rewrite.c>
    RewriteEngine On
    # Если сайт лежит в подпапке — раскомментируйте и укажите путь, например: RewriteBase /shop/
    # RewriteBase /

    # /catalog и /catalog/ → catalog.php
    RewriteRule ^catalog/?$ catalog.php [L,QSA]
</IfModule>

DirectoryIndex index.php index.html
